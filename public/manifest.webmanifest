{
  "name": "Quire",
  "short_name": "Quire",
  "description": "Fast, 120 Hz local-first handwritten notes, multi-page PDF annotation, and stroke-synced audio review.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f4ee",
  "theme_color": "#f7f4ee",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "application/zip": [".quire"]
      }
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*", ".quire"]
        }
      ]
    }
  }
}
